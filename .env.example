# SlintTech Frontend Environment Variables
# Copy this file to .env and fill in the values

# ======================
# API Configuration
# ======================
# API base URL for the backend server
# In development: Set this to point to your local Express server
# In production (Azure SWA): Leave empty or don't set - the /api routes are handled automatically
VITE_API_BASE_URL=

# For local development with Express server running on port 3000:
# VITE_API_BASE_URL=http://localhost:3000

# ======================
# Payment Gateway (Paystack)
# ======================
# This is the PUBLIC key only - safe to expose in frontend
# The SECRET key stays on the backend only
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key

# ======================
# NOTE: Cloudinary credentials are NOT needed on the frontend
# File uploads are handled securely through the backend API
# All Cloudinary credentials should be in server/.env only
# ======================
